#!/usr/bin/perl -w

use esmith::Build::CreateLinks qw(:all);
use esmith::Build::Backup qw(:all);

# our event specific for updating with yum without reboot
$event = 'smeserver-minecraft-update';

foreach my $file (qw(
        /etc/systemd/system-preset/49-koozali.preset
	/etc/httpd/conf/httpd.conf
       /etc/rc.d/init.d/masq
))
{
    templates2events( $file, $event );
};
#action needed in case we have a systemd unit
event_link('msm.sh', $event, '50');

#services we might need to restart
event_services($event, 'msm' => 'restart', 'httpd-e-smith' => 'restart', 'wan' => 'reload');

#Backup contrib files
 backup_includes("minecraft", qw(
   /opt/msm  files(s) to be backed up
));

